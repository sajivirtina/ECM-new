# Ignore everything inside wp-content
/*

# Include the themes directory
!/themes/

# Include all files and subdirectories inside themes
!/themes/**

# Include this .gitignore file
!/.gitignore

# Include the GitHub Actions workflows
!/.github/
!/.github/**

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Dependencies
node_modules/
vendor/

# Logs, env files and backups
*.log
.env
.env.*
*.bak
*.tmp
*.zip